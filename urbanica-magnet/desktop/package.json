{
  "name": "urbanica-magnet",
  "productName": "Urbanica Magnet",
  "description": "Urbanica Magnet – שינוי שמות קבצי מגנטים",
  "author": "Campus",
  "license": "UNLICENSED",
  "main": "main.js",
  "scripts": {
    "start": "electron ."
  },
  "build": {
    "appId": "il.campus.urbanicamagnet",
    "productName": "Urbanica Magnet",
    "files": [
      "main.js",
      "preload.js",
      "app/**/*"
    ],
    "asar": true,
    "mac": {
      "category": "public.app-category.productivity",
      "target": [
        {
          "target": "zip",
          "arch": [
            "arm64"
          ]
        }
      ],
      "identity": null,
      "icon": "build/icon.png",
      "extendInfo": {
        "LSMinimumSystemVersion": "11.0"
      }
    },
    "artifactName": "urbanica-magnet-mac-${arch}.${ext}",
    "directories": {
      "output": "dist"
    },
    "publish": null
  },
  "version": "1.0.0",
  "devDependencies": {
    "electron": "33.2.1",
    "electron-builder": "25.1.8"
  }
}